# =============================================================================
# Olist ERP API v3 (OAuth2)
# =============================================================================
# Fluxo:
#   1. Criar aplicativo no painel Olist com permissão "Produtos" (leitura).
#   2. Preencher CLIENT_ID + CLIENT_SECRET abaixo.
#   3. Rodar: npm run get-token
#      → abre browser, faz login, captura tokens automaticamente.
#   4. Rodar: npm run sync-tiny
# =============================================================================

# --- Credenciais do aplicativo (obrigatórias pra get-token) ---
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=

# URL de redirecionamento (deve bater EXATAMENTE com a cadastrada no painel Olist)
TINY_REDIRECT_URI=http://localhost:3000/callback

# --- Tokens (preenchidos automaticamente por get-token) ---
# access_token dura 4 horas
TINY_ACCESS_TOKEN=
# refresh_token dura 1 dia; usado por `npm run get-token -- --refresh`
TINY_REFRESH_TOKEN=

# --- Configuração do sync ---
TINY_PAGE_SIZE=100
TINY_SITUACAO=A
