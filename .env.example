# =============================================================================
# Olist ERP API v3 (OAuth2)
# =============================================================================
# Fluxo:
#   1. Criar aplicativo no painel Olist com permissão "Produtos" (leitura).
#   2. Preencher CLIENT_ID + CLIENT_SECRET abaixo.
#   3. Rodar: npm run get-token
#      → abre browser, faz login, captura tokens automaticamente.
#   4. Rodar: npm run sync-tiny
# =============================================================================

# --- Credenciais do aplicativo (obrigatórias pra get-token) ---
TINY_CLIENT_ID=
TINY_CLIENT_SECRET=

# URL de redirecionamento (deve bater EXATAMENTE com a cadastrada no painel Olist)
TINY_REDIRECT_URI=http://localhost:3000/callback

# --- Tokens (preenchidos automaticamente por get-token) ---
# access_token dura 4 horas
TINY_ACCESS_TOKEN=
# refresh_token dura 1 dia; usado por `npm run get-token -- --refresh`
TINY_REFRESH_TOKEN=

# --- Configuração do sync ---
TINY_PAGE_SIZE=100
TINY_SITUACAO=A

# =============================================================================
# Frete - Melhor Envio (Jadlog, Correios, Loggi, Azul, LATAM)
# =============================================================================
# Fluxo:
#   1. Criar conta e um aplicativo em https://melhorenvio.com.br
#      (use o sandbox primeiro: https://sandbox.melhorenvio.com.br)
#   2. Preencher CLIENT_ID + CLIENT_SECRET abaixo.
#   3. Cadastrar a URL de redirecionamento no aplicativo, igual à de
#      MELHORENVIO_REDIRECT_URI abaixo.
#   4. Rodar: npm run get-token-frete
#      → abre o browser, autoriza e grava os tokens aqui.
#   5. Copiar MELHORENVIO_REFRESH_TOKEN para a Vercel. A partir daí ele
#      rotaciona sozinho, guardado no mesmo KV usado pelo token do Olist.
#
# ATENÇÃO: sem KV configurado (KV_REST_API_* / UPSTASH_REDIS_REST_*), o token
# rotacionado não tem onde ser gravado e a cotação para de funcionar quando o
# refresh token atual expirar - o mesmo problema que já houve com o Olist.

# sandbox = simulação sem cobrança (só Correios e Jadlog) | producao = valendo
MELHORENVIO_AMBIENTE=sandbox

MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=

# Preenchidos automaticamente por get-token-frete
MELHORENVIO_ACCESS_TOKEN=
MELHORENVIO_REFRESH_TOKEN=

# Precisa bater EXATAMENTE com a cadastrada no aplicativo do Melhor Envio.
# Tem que ser https: o Melhor Envio recusa http, inclusive localhost. Por isso
# a autorizacao volta para o site publicado, numa pagina que mostra o codigo
# para voce colar no terminal.
MELHORENVIO_REDIRECT_URI=https://vmclick.vercel.app/api/callback-melhorenvio

# Cotar precisa só de shipping-calculate. Emitir etiqueta, depois, vai pedir
# também shipping-checkout, shipping-generate e shipping-print.
MELHORENVIO_SCOPE=shipping-calculate

# Exigido pelo Melhor Envio: identifique a aplicação e um e-mail de contato
MELHORENVIO_USER_AGENT=VM Click (contato@vmclick.com.br)

# Opcional: restringe os serviços cotados (ids do Melhor Envio), ex.: 1,2,3
MELHORENVIO_SERVICOS=

# --- Regras da loja -----------------------------------------------------------
# CEP de onde as encomendas saem (a loja, no Portão). CONFIRMAR: sem isto
# preenchido a cotação responde 503.
FRETE_CEP_ORIGEM=

# Faixas de CEP da entrega própria. Padrão: Curitiba + região metropolitana.
FRETE_CEP_LOCAL=80000000-82999999,83000000-83800999

# Entrega própria: valor e piso do frete grátis
FRETE_LOCAL=24.90
FRETE_GRATIS_ACIMA=299
